<Project>
  <!-- NuGet.Packaging (used by AITaskAgent.NugetLoader to read .nupkg files) depends on System.Security.Cryptography.Pkcs for package
       signature verification, which the loader never calls: it checks each .nupkg against the SHA-512 of its own lock file. The versions tried
       (8.0.1, 10.0.0, 10.0.11) are all flagged by the advisory feed in this environment, so raising the version does not clear it. The two
       advisories are acknowledged here, and only for the projects that import this file (the loader and whatever references it). -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
  </ItemGroup>
</Project>
