<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="NuGetAudit.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- IStep, IStepRegistry, the hook attributes and IPluginConfiguration for PluginLoader (the contract only: the loader never references AITaskAgent.Core or Extensions.Llm). -->
  <ItemGroup>
    <ProjectReference Include="..\AITaskAgent.Abstractions\AITaskAgent.Abstractions.csproj" />
  </ItemGroup>

  <!-- NuGet client libraries: the one resolver of the packages an application declares (workflow packages, plugins). -->
  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" Version="7.3.1" />
    <PackageReference Include="NuGet.Packaging" Version="7.3.1" />
    <PackageReference Include="NuGet.Frameworks" Version="7.3.1" />
    <PackageReference Include="NuGet.Versioning" Version="7.3.1" />
  </ItemGroup>

</Project>
