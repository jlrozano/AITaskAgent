{
    "Logging": {
        "LogLevel": {
            "Default": "Trace",
            "Microsoft": "Warning",
            "System.Net.Http": "Trace",
            "AITaskAgent": "Trace",
            "OpenAILLmService": "Trace"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Verbose",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "AITaskAgent": "Verbose",
                "OpenAILLmService": "Verbose"
            }
        }
    },
    "AITaskAgent": {
        "LlmProviders": {
            "Providers": {
                "OpenRouterBase": {
                    "BaseUrl": "https://openrouter.ai/api/v1",
                    "ApiKey": "${OPENROUTER_API_KEY}"
                }
            },
            "Roles": {
                "default": {
                    "Provider": "OpenRouterBase",
                    "Model": "nvidia/nemotron-3-super-120b-a12b:free",
                    "Inference": {
                        "Temperature": 0.7,
                        "MaxTokens": 32000,
                        "UseStreaming": false
                    }
                }
            },
            "DefaultRole": "default"
        }
    }
}