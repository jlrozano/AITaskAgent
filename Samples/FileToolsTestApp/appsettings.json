{
    "Logging": {
        "LogLevel": {
            "Default": "Trace",
            "Microsoft": "Warning",
            "System.Net.Http": "Trace",
            "AITaskAgent": "Trace",
            "OpenAILLmService": "Trace"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Verbose",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning",
                "AITaskAgent": "Verbose",
                "OpenAILLmService": "Verbose"
            }
        }
    },
    "AITaskAgent": {
        "Conversation": {
            "UseSlidingWindow": true,
            "SlidingWindowMaxTokens": 120000
        },
        "LlmProviders": {
            "Providers": {
                "OpenRouterBase": {
                    "ServiceType": "openrouter",
                    "BaseUrl": "https://openrouter.ai/api/v1",
                    "ApiKey": "${OPENROUTER_API_KEY}"
                },
                "Gemini": {
                    "ServiceType": "gemini",
                    "BaseUrl": "https://generativelanguage.googleapis.com/",
                    "ApiKey": "${GEMINI_API_KEY}",
                    "ApiVersion": "v1alpha"
                },
                "AzureOpenAI": {
                    "ServiceType": "azure-openai",
                    "BaseUrl": "${AZURE_OPENAI_ENDPOINT}",
                    "ApiKey": "${AZURE_OPENAI_API_KEY}",
                    "ApiVersion": "2024-08-01-preview"
                }
            },
            "Roles": {
                "default": {
                    "Provider": "OpenRouterBase",
                    "Model": "nvidia/nemotron-3-super-120b-a12b:free",
                    "Inference": {
                        "Temperature": 0.7,
                        "MaxTokens": 32000,
                        "UseStreaming": true
                    }
                },
                "gemini": {
                    "Provider": "Gemini",
                    "Model": "gemini-2.5-flash",
                    "Inference": {
                        "Temperature": 0.7,
                        "MaxTokens": 32000,
                        "UseStreaming": true
                    }
                },
                "azure": {
                    "Provider": "AzureOpenAI",
                    "Model": "gpt-5.4",
                    "Inference": {
                        "Temperature": 0.7,
                        "MaxTokens": 32000,
                        "UseStreaming": true,
                        "UseMaxCompletionTokens": true
                    }
                }
            },
            "DefaultRole": "azure"
        }
    }
}