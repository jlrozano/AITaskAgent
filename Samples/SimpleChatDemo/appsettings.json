{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "AITaskAgent": "Verbose"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "restrictedToMinimumLevel": "Verbose",
          "path": "SimpleChatDemo.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AITaskAgent": {
    "Observability": {
      "EventLogLevel": "Trace",
      "EventChannelCapacity": 1000,
      "EnableTracing": true,
      "EnableMetrics": false
    },
    "Timeouts": {
      "DefaultPipelineTimeout": "03:00:00",
      "DefaultStepTimeout": "01:00:00"
    },
    "Conversation": {
      "MaxTokens": 8192,
      "UseSlidingWindow": true,
      "SlidingWindowMaxTokens": 8192,
      "KeepFirstNMessages": 2,
      "UseBookmarks": true
    },
    "LlmProviders": {
      "Providers": {
        "OpenRouter": {
          "ServiceType": "openai",
          "BaseUrl": "https://openrouter.ai/api/v1/",
          "ApiKey": "${OPENROUTER_API_KEY}"
        },
        "Groq": {
          "ServiceType": "openai",
          "BaseUrl": "https://api.groq.com/openai/v1",
          "ApiKey": "${GROQ_API_KEY}"
        },
        "Ollama": {
          "ServiceType": "openai",
          "BaseUrl": "http://localhost:11434/v1",
          "ApiKey": "ollama"
        },
        "Gemini": {
          "ServiceType": "gemini",
          "BaseUrl": "https://generativelanguage.googleapis.com/",
          "ApiKey": "${GEMINI_API_KEY}",
          "ApiVersion": "v1beta"
        }
      },
      "FallbackProviders": [
        {
          "Provider": "OpenRouter",
          "Model": "nvidia/nemotron-3-super-120b-a12b:free"
        }
      ],
      "Roles": {
        "default": {
          "Provider": "Gemini",
          "Model": "gemini-3.1-flash-lite-preview",
          "Inference": {
            "Temperature": 0.7,
            "UseStreaming": true,
            "Options": {
              "ThinkingConfig": {
                "IncludeThoughts": true,
                "ThinkingBudget": 2048
              }
            }
          }
        },
        "thinking": {
          "Provider": "OpenRouter",
          "Model": "stealth/ox-alpha",
          "Inference": {
            "Temperature": 0.7,
            "Options": {
              "enable_thinking": true
            }
          }
        },
        "openai": {
          "Provider": "OpenRouter",
          "Model": "nvidia/nemotron-3-super-120b-a12b:free",
          "Inference": {
            "Temperature": 0.7,
            "UseStreaming": true,
            "Options": {
              "enable_thinking": true
            }
          }
        }
      }
    }
  }
}
