<Project Sdk="Microsoft.NET.Sdk">

  <!-- El pipeline, su configuración (appsettings.analysis.json) y sus plantillas viven en
       CodebaseAnalysis.Core, que los copia a la salida de este proyecto. -->
  <ItemGroup>
    <ProjectReference Include="..\CodebaseAnalysis.Core\CodebaseAnalysis.Core.csproj" />
    <ProjectReference Include="..\..\McpIntegration\McpIntegration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <UserSecretsId>3e60cd17-5eb3-409f-b631-3ab8497c947d</UserSecretsId>
  </PropertyGroup>

</Project>
