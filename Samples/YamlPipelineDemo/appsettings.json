{
  "AITaskAgent": {
    "LlmProviders": {
      "DefaultRole": "default",
      "Providers": {
        "OpenRouter": {
          "ServiceType": "openai",
          "BaseUrl": "https://openrouter.ai/api/v1",
          "ApiKey": "${OPENROUTER_API_KEY}",
          "Inference": {
            "JsonSupport": true
          }
        }
      },
      "Roles": {
        "default": {
          "Provider": "OpenRouter",
          "Model": "openai/gpt-oss-120b:free"
        }
      }
    }
  }
}
