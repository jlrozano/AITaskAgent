{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http": "Warning"
    }
  },
  "AITaskAgent": {
    "Observability": {
      "EventLogLevel": "None",
      "EventChannelCapacity": 1000,
      "EnableTracing": true,
      "EnableMetrics": false
    },
    "Timeouts": {
      "DefaultPipelineTimeout": "03:00:00",
      "DefaultStepTimeout": "01:00:00"
    },
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "OpenDurationSeconds": 60
    },
    "RateLimit": {
      "TokensPerRefill": 10,
      "RefillIntervalMs": 1000,
      "MaxTokens": 100
    },
    "Conversation": {
      "MaxTokens": 16000,
      "UseSlidingWindow": true,
      "SlidingWindowMaxTokens": 16000,
      "KeepFirstNMessages": 2,
      "UseBookmarks": true
    },
    "LlmProviders": {
      "DefaultRole": "IntentionAnalyzer",
      "Providers": {
        "GoogleBase": {
          "ServiceType": "gemini",
          "BaseUrl": "https://generativelanguage.googleapis.com/",
          "ApiKey": "${GOOGLE_API_KEY}",
          "Inference": {
            "Temperature": 0.3,
            "JsonSupport": true
          }
        },
        "OpenRouterBase": {
          "ServiceType": "openai",
          "BaseUrl": "https://openrouter.ai/api/v1",
          "ApiKey": "${OPENROUTER_API_KEY}",
          "Inference": {
            "JsonSupport": true
          }
        },
        "GroqBase": {
          "ServiceType": "openai",
          "BaseUrl": "https://api.groq.com/openai/v1",
          "ApiKey": "${GROQ_API_KEY}",
          "Inference": {
            "JsonSupport": true
          }
        }
      },
      "FallbackProviders": [
        {
          "Provider": "GoogleBase",
          "Model": "gemini-2.0-flash"
        },
        {
          "Provider": "OpenRouterBase",
          "Model": "openai/gpt-oss-120b:free"
        },
        {
          "Provider": "GroqBase",
          "Model": "openai/gpt-oss-20b"
        }
      ],
      "Roles": {
        "IntentionAnalyzer": {
          "Provider": "GoogleBase",
          "Model": "gemini-2.5-flash",
          "SystemPrompt": "Eres un experto en análisis de intenciones. Tu tarea es clasificar la petición del usuario en una de las categorías disponibles y proporcionar un prompt optimizado para el siguiente paso.",
          "Inference": {
            "Temperature": 0.3,
            "MaxTokens": 2000,
            "JsonSupport": true
          }
        },
        "Outliner": {
          "Provider": "OpenRouterBase",
          "Model": "openai/gpt-oss-120b:free",
          "SystemPrompt": "Eres un guionista experto. Tu tarea es crear un esquema detallado para un cuento basado en la idea del usuario.",
          "Inference": {
            "Temperature": 0.7,
            "MaxTokens": 4000
          }
        },
        "Writers": {
          "Provider": "OpenRouterBase",
          "Model": "openai/gpt-oss-120b:free",
          "SystemPrompt": "Eres un escritor creativo de cuentos. Tu tarea es desarrollar una sección del cuento siguiendo el esquema proporcionado.",
          "Inference": {
            "Temperature": 0.8,
            "MaxTokens": 8000
          }
        },
        "Critic": {
          "Provider": "GroqBase",
          "Model": "openai/gpt-oss-20b",
          "SystemPrompt": "Eres un editor literario exigente. Tu tarea es revisar los borradores y proporcionar críticas constructivas para mejorar la coherencia, el ritmo y el estilo.",
          "Inference": {
            "Temperature": 0.2,
            "MaxTokens": 4000,
            "JsonSupport": true
          }
        },
        "Rewriter": {
          "Provider": "OpenRouterBase",
          "Model": "openai/gpt-oss-120b:free",
          "SystemPrompt": "Eres un corrector de estilo. Tu tarea es reescribir el cuento integrando las críticas recibidas para lograr una versión final pulida.",
          "Inference": {
            "Temperature": 0.5,
            "MaxTokens": 12000
          }
        },
        "Publisher": {
          "Provider": "GroqBase",
          "Model": "openai/gpt-oss-20b",
          "SystemPrompt": "Eres un editor jefe. Tu tarea es dar el formato final al cuento y asegurar que esté listo para su publicación.",
          "Inference": {
            "Temperature": 0.3,
            "MaxTokens": 16000
          }
        },
        "StoryReviewer": {
          "Provider": "GroqBase",
          "Model": "openai/gpt-oss-20b",
          "SystemPrompt": "Eres un crítico literario. Tu tarea es analizar un cuento existente y sugerir mejoras o responder dudas sobre el mismo.",
          "Inference": {
            "Temperature": 0.5,
            "MaxTokens": 4000
          }
        },
        "QuestionsAssistant": {
          "Provider": "OpenRouterBase",
          "Model": "openai/gpt-oss-120b:free",
          "SystemPrompt": "Eres un asistente amable experto en literatura. Tu tarea es responder cualquier duda del usuario sobre el proceso creativo o el cuento actual.",
          "Inference": {
            "Temperature": 0.6,
            "MaxTokens": 2000
          }
        }
      }
    }
  }
}