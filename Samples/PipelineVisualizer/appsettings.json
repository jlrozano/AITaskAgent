{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "System.Net.Http": "Warning"
        }
    },
    "AllowedHosts": "*",
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        }
    },
    "AITaskAgent": {
        "TemplatesPath": "templates",
        "LlmProviders": {
            "DefaultRole": "IntentionAnalyzer",
            // Connection targets. All of them speak the OpenAI wire protocol, hence the single
            // ServiceType: it is matched against ILlmService.Name, not against the vendor.
            // JsonSupport lives here rather than per role, so it is enabled on the providers whose
            // roles need structured output.
            "Providers": {
                "NVidia": {
                    "ServiceType": "openai",
                    "BaseUrl": "https://integrate.api.nvidia.com/v1",
                    "ApiKey": "<key>"
                },
                "OpenRouter": {
                    "ServiceType": "openai",
                    "BaseUrl": "https://openrouter.ai/api/v1",
                    "ApiKey": "<key>",
                    "Inference": {
                        "JsonSupport": true
                    }
                },
                "Groq": {
                    "ServiceType": "openai",
                    "BaseUrl": "https://api.groq.com/openai/v1",
                    "ApiKey": "<key>",
                    "Inference": {
                        "JsonSupport": true
                    }
                },
                "AIML": {
                    "ServiceType": "openai",
                    "BaseUrl": "https://api.aimlapi.com/v1",
                    "ApiKey": "<key>"
                }
            },
            // Keys must match the role names PipelineExecutor resolves for each StoryMachine step.
            "Roles": {
                "IntentionAnalyzer": {
                    "Provider": "NVidia",
                    "Model": "meta/llama-3.1-8b-instruct",
                    "Inference": {
                        "Temperature": 0.5,
                        "MaxTokens": 16000
                    }
                },
                "Outliner": {
                    "Provider": "OpenRouter",
                    "Model": "openai/gpt-oss-120b:free",
                    "Inference": {
                        "Temperature": 0.7,
                        "MaxTokens": 16000
                    }
                },
                "Writers": {
                    "Provider": "NVidia",
                    "Model": "meta/llama-3.1-8b-instruct",
                    "Inference": {
                        "Temperature": 0.5,
                        "MaxTokens": 16000
                    }
                },
                "Critic": {
                    "Provider": "Groq",
                    "Model": "openai/gpt-oss-20b",
                    "Inference": {
                        "Temperature": 0.7,
                        "MaxTokens": 16000
                    }
                },
                "Rewriter": {
                    "Provider": "AIML",
                    "Model": "qwen3-32b",
                    "Inference": {
                        "Temperature": 0.5,
                        "MaxTokens": 16000
                    }
                },
                "Publisher": {
                    "Provider": "Groq",
                    "Model": "openai/gpt-oss-20b",
                    "Inference": {
                        "Temperature": 1.0,
                        "MaxTokens": 16000
                    }
                },
                "StoryReviewer": {
                    "Provider": "Groq",
                    "Model": "openai/gpt-oss-20b",
                    "Inference": {
                        "Temperature": 0.5,
                        "MaxTokens": 16000
                    }
                },
                "QuestionsAssistant": {
                    "Provider": "AIML",
                    "Model": "qwen3-32b",
                    "Inference": {
                        "Temperature": 0.5,
                        "MaxTokens": 16000
                    }
                }
            }
        },
        "StepTypeStyles": {
            "BaseLlmStep": {
                "Icon": "MessageSquare",
                "Color": "#3B82F6",
                "BorderColor": "#60A5FA",
                "BackgroundColor": "#EFF6FF"
            },
            "IntentionAnalyzerStep": {
                "Icon": "BrainCircuit",
                "Color": "#8B5CF6",
                "BorderColor": "#A78BFA",
                "BackgroundColor": "#F5F3FF"
            },
            "RouterStep": {
                "Icon": "GitFork",
                "Color": "#F59E0B",
                "BorderColor": "#FBBF24",
                "BackgroundColor": "#FEF3C7"
            },
            "GroupStep": {
                "Icon": "Box",
                "Color": "#64748B",
                "BorderColor": "#94A3B8",
                "BackgroundColor": "#F8FAFC"
            },
            "ParallelStep": {
                "Icon": "Columns",
                "Color": "#10B981",
                "BorderColor": "#34D399",
                "BackgroundColor": "#ECFDF5"
            },
            "StatelessRewriterStep": {
                "Icon": "PenTool",
                "Color": "#EC4899",
                "BorderColor": "#F472B6",
                "BackgroundColor": "#FDF2F8"
            },
            "DelegatedStep": {
                "Icon": "Code",
                "Color": "#6B7280",
                "BorderColor": "#9CA3AF",
                "BackgroundColor": "#F9FAFB"
            }
        }
    }
}
