            {
              "Name": "gpt-5.4",
              "InputPricePerMillion": 2.5,
              "OutputPricePerMillion": 15,
              "CachedInputPricePerMillion": 0.25
            },
            {
              "Name": "gpt-4.1-mini",
              "InputPricePerMillion": 0.4,
              "OutputPricePerMillion": 1.6
