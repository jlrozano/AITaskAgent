            {
              "Name": "gpt-5-nano",
              "InputPricePerMillion": 0.05,
              "OutputPricePerMillion": 0.4
            },
            {
              "Name": "o4-mini",
              "InputPricePerMillion": 1.1,
              "OutputPricePerMillion": 4.4
            },
            {
              "Name": "gpt-oss-120b",
              "InputPricePerMillion": null,
              "OutputPricePerMillion": null
            }
          ]
        }
