{
  "CodebaseAnalysis": {
    "RepositoryPath": ".",
    "DatabasePath": ".codebase/codebase.db",
    "OutputReportsPath": "reports",
    "ForceReindex": false,
    "RequestedReports": [
      "analisis_funcional",
      "code_smells",
      "codigo_muerto",
      "flujos_end_to_end",
      "errores_y_bugs",
      "arquitectura_acoplamiento",
      "inventario_apis_seguridad",
      "deuda_tecnica_hotspots",
      "inyeccion_dependencias_extensiones"
    ],
    "Auditors": {
      "MaxToolIterations": 12,
      "MaxToolIterationsByRole": {
        "FlowsAuditor": 16
      }
    },
    "Timeouts": {
      "PipelineMinutes": 240,
      "DetectMinutes": 15,
      "EnrichMinutes": 20,
      "ReportsMinutes": 60,
      "AuditorMinutes": 15,
      "SynthesisMinutes": 15
    },
    "Chat": {
      "MaxToolIterations": 12,
      "MaxHistoryTurns": 20,
      "TurnTimeoutMinutes": 5
    },
    "Documents": {
      "MaxDocuments": 300,
      "MaxTotalMegabytes": 500,
      "VisionRole": "ChatAssistant",
      "IncludeInAnalysisByDefault": true,
      "AnalysisIndexMaxChars": 8000
    },
    "Embeddings": {
      "Enabled": true,
      "Provider": "AzureOpenAI",
      "Model": "text-embedding-3-small",
      "Dimensions": null,
      "BatchSize": 32,
      "MaxChunkChars": 1800,
      "ChunkOverlapChars": 200
    }
  },
  "McpServers": {
    "CodebaseMemory": {
      "ConnectMcp": false,
      "Transport": "Stdio",
      "Arguments": ["mcp"],
      "WorkingDirectory": ".",
      "EnvironmentVariables": {
        "CODEBASE_MEMORY_DB": ".codebase/codebase.db"
      },
      "TimeoutSeconds": 120
    }
  },
  "BdpEnricher": {
    "Enabled": true,
    "Required": false
  },
  "JavaAnalyzer": {
    "Enabled": true,
    "JdkPath": "",
    "JvmOptions": ["-Xmx8g", "-XX:+UseG1GC"],
    "BatchSize": 0,
    "MaxParallelBatches": 1,
    "ProvidedClasspath": [],
    "TestRoots": [],
    "DefaultEncoding": "",
    "TimeoutSeconds": 900,
    "StepTimeoutSeconds": 3600
  },
  "StrutsJsp": {
    "Enabled": true,
    "SuspiciousImportPatterns": [
      "^java\\.sql(\\.|$)",
      "^javax\\.sql(\\.|$)",
      "(?i)(^|\\.)dao(\\.|$)|DAO\\b"
    ],
    "BusinessImportPatterns": [
      "(?i)\\.(negocio|business|service)\\."
    ]
  },
  "LlmConfiguration": {
    "DefaultProvider": "AzureOpenAI",
    "Providers": {
      "AzureOpenAI": {
        "ServiceType": "azure-openai",
        "ApiKey": "${Asistente__ApiKey}",
        "Endpoint": "https://ismae-m9sp765u-swedencentral.cognitiveservices.azure.com/",
        "BaseUrl": "https://ismae-m9sp765u-swedencentral.cognitiveservices.azure.com/",
        "ApiVersion": "2024-08-01-preview",
        "Model": "gpt-5.4",
        "Inference": {
          "UseMaxCompletionTokens": true,
          "JsonSupport": true,
          "RequestTimeoutSeconds": 300
        }
      }
    },
    "Roles": {
      "Enricher": {
        "SystemPrompt": "enricher_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.1,
        "MaxOutputTokens": 65536,
        "TopP": 0.95,
        "UseMaxCompletionTokens": true
      },
      "FunctionalAuditor": {
        "SystemPrompt": "report_funcional_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.2,
        "MaxOutputTokens": 65536,
        "UseMaxCompletionTokens": true
      },
      "CodeSmellsAuditor": {
        "SystemPrompt": "report_codesmells_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.1,
        "MaxOutputTokens": 65536,
        "UseMaxCompletionTokens": true
      },
      "DeadCodeAuditor": {
        "SystemPrompt": "report_codigomuerto_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.1,
        "MaxOutputTokens": 65536,
        "UseMaxCompletionTokens": true
      },
      "FlowsAuditor": {
        "SystemPrompt": "report_flujos_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.1,
        "MaxOutputTokens": 65536,
        "UseMaxCompletionTokens": true
      },
      "SecurityBugAuditor": {
        "SystemPrompt": "report_errores_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.1,
        "MaxOutputTokens": 65536,
        "UseMaxCompletionTokens": true
      },
      "ArchitectureAuditor": {
        "SystemPrompt": "report_arquitectura_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.1,
        "MaxOutputTokens": 65536,
        "UseMaxCompletionTokens": true
      },
      "ApiSecurityAuditor": {
        "SystemPrompt": "report_apis_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.1,
        "MaxOutputTokens": 65536,
        "UseMaxCompletionTokens": true
      },
      "TechnicalDebtAuditor": {
        "SystemPrompt": "report_deuda_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.1,
        "MaxOutputTokens": 65536,
        "UseMaxCompletionTokens": true
      },
      "DiAuditor": {
        "SystemPrompt": "report_di_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.1,
        "MaxOutputTokens": 65536,
        "UseMaxCompletionTokens": true
      },
      "ExecutiveSynthesizer": {
        "SystemPrompt": "report_sintesis_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.2,
        "MaxOutputTokens": 65536,
        "UseMaxCompletionTokens": true
      },
      "ChatAssistant": {
        "SystemPrompt": "chat_system",
        "Provider": "AzureOpenAI",
        "Model": "gpt-5.4",
        "Temperature": 0.2,
        "MaxOutputTokens": 32768,
        "UseMaxCompletionTokens": true,
        "UseStreaming": true,
        "StreamingInactivityTimeoutSeconds": 300
      }
    }
  },
  "AITaskAgent": {
    "Conversation": {
      "UseSlidingWindow": true,
      "SlidingWindowMaxTokens": 262144
    }
  }
}
