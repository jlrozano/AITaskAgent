{
  "CodebaseAnalysis": {
    "RepositoryPath": ".",
    "DatabasePath": ".codebase/codebase.db",
    "OutputReportsPath": "reports",
    "LogsPath": "logs",
    "ForceReindex": false,
    "Backups": {
      "Keep": 5
    },
    "RequestedReports": [
      "analisis_funcional",
      "code_smells",
      "codigo_muerto",
      "flujos_end_to_end",
      "errores_y_bugs",
      "arquitectura_acoplamiento",
      "inventario_apis_seguridad",
      "deuda_tecnica_hotspots",
      "inyeccion_dependencias_extensiones"
    ],
    "Auditors": {
      "MaxToolIterations": 100,
      "MaxToolIterationsByRole": {
        "FlowsAuditor": 100
      }
    },
    "Timeouts": {
      "PipelineMinutes": 0,
      "DetectMinutes": 0,
      "EnrichMinutes": 0,
      "ReportsMinutes": 0,
      "AuditorMinutes": 0,
      "SynthesisMinutes": 0,
      "VerifierMinutes": 0
    },
    "Preparation": {
      "Mode": "Subsystems",
      "MaxSubsystemsPerReport": 50,
      "MaxParallelInvestigations": 4,
      "VocabularyMergeThreshold": 0.5,
      "MinSubsystemFiles": 5,
      "MaxSubsystemShare": 0.05,
      "PathTermWeightFactor": 1.25,
      "SharedMinConsumers": 3,
      "SharedMinConsumerShare": 0.2,
      "LongTailSize": 3,
      "ConsolidationMaxToolIterations": 0,
      "Weights": {
        "Centrality": 3,
        "EntryPoints": 2,
        "Tables": 2,
        "States": 1,
        "Integrations": 1,
        "DynamicUseRisk": 1
      },
      "ReportProfiles": {
        "AnalisisFuncional": { "Centrality": 0.5, "EntryPoints": 2.5, "Tables": 1.5, "States": 3, "Integrations": 0.5, "DynamicUseRisk": 0.5 },
        "FlujosEndToEnd": { "Centrality": 0.5, "EntryPoints": 3, "Tables": 1.5, "States": 2, "Integrations": 1, "DynamicUseRisk": 0.5 },
        "ErroresYBugs": { "Centrality": 1, "EntryPoints": 0.5, "Tables": 0.5, "States": 0.5, "Integrations": 3, "DynamicUseRisk": 3 },
        "ArquitecturaAcoplamiento": { "Centrality": 1.5, "EntryPoints": 0.5, "Tables": 1, "States": 0.5, "Integrations": 2, "DynamicUseRisk": 0.5 }
      },
      "CountedExtensions": [".java", ".cs", ".jsp", ".js", ".ts"],
      "StopTokens": [
        "impl", "dao", "action", "actions", "util", "utils", "service", "services", "manager", "bean", "beans", "helper",
        "factory", "base", "abstract", "test", "tests", "exception", "dto", "vo", "form", "forms", "command", "controller",
        "handler", "model", "entity", "repository", "repo", "common", "core", "main", "java", "src", "com", "org", "net",
        "get", "set", "is", "new", "default", "generic", "config", "configuration"
      ]
    },
    "TimeBudget": {
      "Investigation": { "BaseMinutes": 0, "MinutesPerUnit": 0, "MinMinutes": 0, "MaxMinutes": 0 },
      "Consolidation": { "BaseMinutes": 0, "MinutesPerUnit": 0, "MinMinutes": 0, "MaxMinutes": 0 },
      "Auditor": { "BaseMinutes": 0, "MinutesPerUnit": 0, "MinMinutes": 0, "MaxMinutes": 0 }
    },
    "SharedPass": {
      "Enabled": false,
      "MaxBatchTokens": 50000,
      "ReaderRole": "SharedPassReader",
      "JudgeRole": "SharedPassJudge",
      "JudgeBatchSize": 20,
      "JudgeContextLines": 15,
      "JudgeConfidenceThreshold": 0.6,
      "MaxParallelBatches": 4,
      "MaxCostPerBatchUsd": 2,
      "MaxCostPerStageUsd": 10,
      "MaxCostPerRunUsd": 25,
      "MaxMinutes": 90,
      "MaxCallsPerRun": 1000,
      "MaxTokensPerRun": 50000000,
      "MaxReaderRetries": 2,
      "MaxFileChars": 200000,
      "MaxRelationsPerDirection": 80
    },
    "Chat": {
      "MaxToolIterations": 12,
      "MaxHistoryTurns": 20,
      "TurnTimeoutMinutes": 5,
      "DefaultModel": "gpt-6-sol",
      "Models": [
        { "Id": "gpt-6-sol", "Label": "GPT-6 Sol", "Role": "ChatAssistant", "Streaming": false },
        { "Id": "gpt-6-luna", "Label": "GPT-6 Luna (barato)", "Role": "Chat.gpt-6-luna", "Streaming": false },
        { "Id": "gpt-5.6-terra", "Label": "GPT-5.6 Terra", "Role": "Chat.gpt-5.6-terra", "Streaming": false },
        { "Id": "gpt-5.4", "Label": "GPT-5.4", "Role": "Chat.gpt-5.4", "Streaming": false },
        { "Id": "gpt-6-sol-global", "Label": "GPT-6 Sol (global)", "Role": "Chat.gpt-6-sol-global", "Streaming": false },
        { "Id": "gpt-4.1-mini", "Label": "GPT-4.1 mini (rápido)", "Role": "Chat.gpt-4.1-mini", "Streaming": true },
        { "Id": "gpt-4.1-nano", "Label": "GPT-4.1 nano (muy barato)", "Role": "Chat.gpt-4.1-nano", "Streaming": true },
        { "Id": "gpt-5-mini", "Label": "GPT-5 mini", "Role": "Chat.gpt-5-mini", "Streaming": false },
        { "Id": "gpt-5-nano", "Label": "GPT-5 nano", "Role": "Chat.gpt-5-nano", "Streaming": false },
        { "Id": "o4-mini", "Label": "o4-mini (razonamiento)", "Role": "Chat.o4-mini", "Streaming": true },
        { "Id": "gpt-oss-120b", "Label": "GPT-OSS 120B", "Role": "Chat.gpt-oss-120b", "Streaming": true }
      ]
    },
    "Documents": {
      "MaxDocuments": 300,
      "MaxTotalMegabytes": 500,
      "VisionRole": "Chat.gpt-5.4",
      "IncludeInAnalysisByDefault": true,
      "AnalysisIndexMaxChars": 8000
    },
    "Embeddings": {
      "Enabled": true,
      "Provider": "AzureOpenAI",
      "Model": "text-embedding-3-small",
      "Dimensions": null,
      "BatchSize": 32,
      "MaxChunkChars": 1800,
      "ChunkOverlapChars": 200
    }
  },
  "McpServers": {
    "CodebaseMemory": {
      "ConnectMcp": false,
      "Transport": "Stdio",
      "Arguments": ["mcp"],
      "WorkingDirectory": ".",
      "EnvironmentVariables": {
        "CODEBASE_MEMORY_DB": ".codebase/codebase.db"
      },
      "TimeoutSeconds": 120
    }
  },
  "DotNetEnricher": {
    "Enabled": true,
    "Required": false,
    "TimeoutSeconds": 900,
    "Restore": "auto",
    "RestoreTimeoutSeconds": 300
  },
  "JavaAnalyzer": {
    "Enabled": true,
    "JdkPath": "",
    "JvmOptions": ["-Xmx8g", "-XX:+UseG1GC"],
    "BatchSize": 0,
    "MaxParallelBatches": 1,
    "ProvidedClasspath": [],
    "TestRoots": [],
    "DefaultEncoding": "",
    "TimeoutSeconds": 900,
    "StepTimeoutSeconds": 3600,
    "KeepIntermediate": false
  },
  "StrutsJsp": {
    "Enabled": true,
    "SuspiciousImportPatterns": [
      "^java\\.sql(\\.|$)",
      "^javax\\.sql(\\.|$)",
      "(?i)(^|\\.)dao(\\.|$)|DAO\\b"
    ],
    "BusinessImportPatterns": [
      "(?i)\\.(negocio|business|service)\\."
    ]
  },
  "AITaskAgent": {
    "LlmProviders": {
      "DefaultRole": "Enricher",
      "Providers": {
        "AzureOpenAI": {
          "ServiceType": "azure-openai",
          "BaseUrl": "https://ismae-m9sp765u-swedencentral.cognitiveservices.azure.com/",
          "ApiKey": "${Asistente__ApiKey}",
          "ApiVersion": "2024-08-01-preview",
          "Inference": {
            "UseMaxCompletionTokens": true,
            "JsonSupport": true,
            "RequestTimeoutSeconds": 300,
            "Options": {
              "MaxConcurrentRequests": 9
            }
