              "OutputPricePerMillion": 10
            },
            {
              "Name": "gpt-4.1-nano",
              "InputPricePerMillion": 0.1,
              "OutputPricePerMillion": 0.4
            },
            {
              "Name": "gpt-5-mini",
              "InputPricePerMillion": 0.25,
              "OutputPricePerMillion": 2
