<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Framework\AITaskAgent.csproj" />
    <ProjectReference Include="..\..\OpenAILLmService\OpenAILLmService.csproj" />
    <ProjectReference Include="..\..\OfficeTools\OfficeTools.csproj" />
    <ProjectReference Include="..\..\FileTools\FileTools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.1" />
    <!-- V2-C: extracción de los documentos subidos (plan v2 §7.2). OpenXml en la versión de OfficeTools. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.2.0" />
  </ItemGroup>

  <!-- Configuración y plantillas viajan con la librería: un ejecutable que la referencia las
       recibe en su carpeta de salida (CLI y, más adelante, la web). -->
  <ItemGroup>
    <None Update="appsettings.analysis.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="templates\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Plantilla vacía de hallazgos esperados para la validación de informes (recomendación 13 de la auditoría). -->
    <None Update="evaluation\expected-findings.template.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- El analizador Java se ejecuta como fuente con el source launcher del JDK (D13): viaja como contenido. -->
    <None Update="Enrichment\Java\JavaAnalyzer.java">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodebaseAnalysis.Core.Tests" />
  </ItemGroup>

  <!-- El enriquecedor Roslyn (DotNetEnricherStep) es un CLI aparte que se lanza como proceso: se compila con Core pero no
       se referencia su ensamblado (ReferenceOutputAssembly=false) ni pasa a los que referencian Core (PrivateAssets=all;
       si pasara, tendrían dos copias de los ficheros que enlaza de aquí). Private=false evita que el SDK copie su .exe suelto
       (sin su .dll) a la raíz de cada ejecutable. Su salida viaja como contenido de Core a
       dotnet-enricher/ en la carpeta de cada ejecutable que lo referencia (CLI, web, tests), como el analizador Java. -->
  <ItemGroup>
    <ProjectReference Include="..\DotNetEnricher\DotNetEnricher.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" Private="false" />
  </ItemGroup>

  <!-- Se añade antes de AssignTargetPaths, que también corre cuando un proyecto que referencia Core le pide su contenido.
       Con un OutDir común para todos los proyectos (-p:OutDir=...) el CLI ya está en la misma carpeta que la app y no se
       copia: DotNetEnricherStep lo busca en los dos sitios. -->
  <Target Name="IncludeDotNetEnricherOutput" BeforeTargets="AssignTargetPaths">
    <MSBuild Projects="..\DotNetEnricher\DotNetEnricher.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_DotNetEnricherTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_DotNetEnricherOutDir>@(_DotNetEnricherTargetPath->'%(RootDir)%(Directory)')</_DotNetEnricherOutDir>
      <_DotNetEnricherSharesOutDir Condition="'$([System.IO.Path]::GetFullPath($(_DotNetEnricherOutDir)))' == '$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(OutDir)))))'">true</_DotNetEnricherSharesOutDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(_DotNetEnricherSharesOutDir)' != 'true' And Exists('$(_DotNetEnricherOutDir)')">
      <_DotNetEnricherFiles Include="$(_DotNetEnricherOutDir)**\*" />
      <None Include="@(_DotNetEnricherFiles)" Link="dotnet-enricher\%(_DotNetEnricherFiles.RecursiveDir)%(_DotNetEnricherFiles.Filename)%(_DotNetEnricherFiles.Extension)"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    </ItemGroup>
  </Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <RootNamespace>CodebaseAnalysis.Core</RootNamespace>
  </PropertyGroup>

</Project>
