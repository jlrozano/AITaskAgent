<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AITaskAgent.Script.Worker</RootNamespace>
    <AssemblyName>AITaskAgent.Extensions.Script.Worker</AssemblyName>
    <!-- Short-lived, single-script process: the smallest and most predictable footprint. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <!-- Wire format and limits are shared with the host project, not duplicated. -->
  <ItemGroup>
    <Compile Include="..\AITaskAgent.Extensions.Script\Protocol\ScriptProtocol.cs" Link="Protocol\ScriptProtocol.cs" />
    <Compile Include="..\AITaskAgent.Extensions.Script\Protocol\ScriptBundle.cs" Link="Protocol\ScriptBundle.cs" />
  </ItemGroup>

  <!-- ClearScript lives only here: the one project in the solution that references V8. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.0" />
    <PackageReference Include="Microsoft.ClearScript.V8.ICUData" Version="7.5.0" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.linux-x64" Version="7.5.0" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.0" />
  </ItemGroup>

</Project>
