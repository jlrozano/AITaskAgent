  {
   "type": "rectangle",
   "id": "why",
   "x": 1440,
   "y": 160,
   "width": 820,
   "height": 250,
   "strokeColor": "#1e3a5f",
   "backgroundColor": "#eff6ff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 200173,
