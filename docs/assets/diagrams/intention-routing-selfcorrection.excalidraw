   }
  },
  {
   "type": "text",
   "id": "budget_t",
   "x": 1464,
   "y": 458,
   "width": 457,
   "height": 140,
   "text": "The correction is not free\n\nEach invented route costs one retry attempt from\nthe step's MaxRetries. A model that keeps guessing\nwrong exhausts the budget and the step comes back\nas an error carrying the last validation message,\n\"Selected option 'X' is not valid...\", not a route.\nIf that happens often, fix the catalogue descriptions.",
   "originalText": "The correction is not free\n\nEach invented route costs one retry attempt from\nthe step's MaxRetries. A model that keeps guessing\nwrong exhausts the budget and the step comes back\nas an error carrying the last validation message,\n\"Selected option 'X' is not valid...\", not a route.\nIf that happens often, fix the catalogue descriptions.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 200179,
   "version": 1,
   "versionNonce": 200180,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "rectangle",
   "id": "two",
   "x": 1440,
   "y": 650,
   "width": 820,
   "height": 200,
   "strokeColor": "#6d28d9",
   "backgroundColor": "#f5f3ff",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 200181,
   "version": 1,
   "versionNonce": 200182,
   "isDeleted": false,
