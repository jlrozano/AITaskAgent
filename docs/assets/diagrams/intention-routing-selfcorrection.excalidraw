  },
  {
   "type": "text",
   "id": "why_t",
   "x": 1464,
   "y": 178,
   "width": 776,
   "height": 214,
   "text": "Why this needs no enum\n\nOptions are strings, described at runtime by an\nIntentionOption catalogue. There is no type\nparameter and no compile-time list, which is what\nlets a route set come from configuration, a\ndatabase, or a tenant.\n\nThe cost of that flexibility is exactly the problem\nabove: nothing stops the model returning a string\nthat is not in the set. So the check is a runtime\nvalidation instead of a type.",
   "originalText": "Why this needs no enum\n\nOptions are strings, described at runtime by an\nIntentionOption catalogue. There is no type\nparameter and no compile-time list, which is what\nlets a route set come from configuration, a\ndatabase, or a tenant.\n\nThe cost of that flexibility is exactly the problem\nabove: nothing stops the model returning a string\nthat is not in the set. So the check is a runtime\nvalidation instead of a type.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 200175,
   "version": 1,
   "versionNonce": 200176,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "rectangle",
   "id": "budget",
   "x": 1440,
   "y": 440,
   "width": 820,
   "height": 180,
   "strokeColor": "#b45309",
   "backgroundColor": "#fffbeb",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 200177,
   "version": 1,
   "versionNonce": 200178,
   "isDeleted": false,
   "groupIds": [],
