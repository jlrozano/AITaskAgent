  },
  {
   "type": "text",
   "id": "two_t",
   "x": 1464,
   "y": 668,
   "width": 776,
   "height": 164,
   "text": "Two separate steps, two separate failures\n\nThe analyzer can only fail by choosing something\noutside the catalogue, and that is recoverable.\n\nThe router can only fail by having no route for a\nvalid choice, and that is not: it throws. Keeping the\ncatalogue and the Routes dictionary in step is the\nwhole job, and nothing checks it for you.",
   "originalText": "Two separate steps, two separate failures\n\nThe analyzer can only fail by choosing something\noutside the catalogue, and that is recoverable.\n\nThe router can only fail by having no route for a\nvalid choice, and that is not: it throws. Keeping the\ncatalogue and the Routes dictionary in step is the\nwhole job, and nothing checks it for you.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#5b21b6",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 200183,
   "version": 1,
   "versionNonce": 200184,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
