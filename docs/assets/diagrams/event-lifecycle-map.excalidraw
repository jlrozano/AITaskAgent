      "roundness": {"type": 3} },
    { "type": "text", "id": "gotcha_t", "x": 1722, "y": 658, "width": 656, "height": 194,
      "text": "Two things that will surprise a UI\n\nstep.started arrives more than once for the same\nstep. Count attempts, do not assume one start\nmeans one step.\n\nstep.completed arrives once even after several\nattempts, so pairing starts with completions\none-to-one will leak.\n\nAnd a run that suspends never emits\npipeline.completed.",
      "originalText": "Two things that will surprise a UI\n\nstep.started arrives more than once for the same\nstep. Count attempts, do not assume one start\nmeans one step.\n\nstep.completed arrives once even after several\nattempts, so pairing starts with completions\none-to-one will leak.\n\nAnd a run that suspends never emits\npipeline.completed.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#991b1b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 220079, "version": 1, "versionNonce": 220080, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "foot", "x": 100, "y": 900, "width": 2300, "height": 19,
      "text": "Sixteen event types are emitted; four more are declared and dormant. Verified against the emitters named on each line.",
      "originalText": "Sixteen event types are emitted; four more are declared and dormant. Verified against the emitters named on each line.",
