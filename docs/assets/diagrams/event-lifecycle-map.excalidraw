   }
  },
  {
   "type": "text",
   "id": "dead_t",
   "angle": 0,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "seed": 900144,
   "version": 1,
   "versionNonce": 900145,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "fillStyle": "solid",
   "backgroundColor": "transparent",
   "strokeWidth": 1,
   "x": 1918,
   "y": 455.5,
   "width": 604,
   "height": 211.25,
   "text": "Declared, but never emitted\n\n  step.cached_hit\n  pipeline.resuming\n  pipeline.resumed\n\nThe types exist and you can subscribe to them, but the\nframework never sends them. Do not build a resume UI\non the last two.\n\nstep.progress has no fixed type: StepProgressEvent takes its\nEventType from the sender. Only FileTools send it, as\n\"ToolProgress\" (BaseFileTool.cs:43-48).",
   "originalText": "Declared, but never emitted\n\n  step.cached_hit\n  pipeline.resuming\n  pipeline.resumed\n\nThe types exist and you can subscribe to them, but the\nframework never sends them. Do not build a resume UI\non the last two.\n\nstep.progress has no fixed type: StepProgressEvent takes its\nEventType from the sender. Only FileTools send it, as\n\"ToolProgress\" (BaseFileTool.cs:43-48).",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#475569",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "rectangle",
   "id": "gotcha",
   "angle": 0,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "seed": 900146,
   "version": 1,
   "versionNonce": 900147,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "fillStyle": "solid",
   "backgroundColor": "#fee2e2",
   "strokeWidth": 2,
   "x": 1900,
   "y": 765.45,
   "width": 640,
   "height": 237.5,
   "strokeColor": "#dc2626",
   "roundness": {
