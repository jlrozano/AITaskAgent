   }
  },
  {
   "type": "text",
   "id": "gotcha_t",
   "angle": 0,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "seed": 900148,
   "version": 1,
   "versionNonce": 900149,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "fillStyle": "solid",
   "backgroundColor": "transparent",
   "strokeWidth": 1,
   "x": 1918,
   "y": 783.45,
   "width": 604,
   "height": 162.5,
   "text": "Two things that will surprise a UI\n\nstep.started arrives more than once for the same step\n(once per attempt). step.completed arrives once, so\npairing starts with completions one-to-one will leak.\n\nA run that suspends still ends with pipeline.completed,\nbut with Success = false and ErrorMessage \"Suspended\nawaiting input\" (Pipeline.cs:181-199). Do not wait for\na missing event; read Success and the message.",
   "originalText": "Two things that will surprise a UI\n\nstep.started arrives more than once for the same step\n(once per attempt). step.completed arrives once, so\npairing starts with completions one-to-one will leak.\n\nA run that suspends still ends with pipeline.completed,\nbut with Success = false and ErrorMessage \"Suspended\nawaiting input\" (Pipeline.cs:181-199). Do not wait for\na missing event; read Success and the message.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#991b1b",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "foot",
   "angle": 0,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "seed": 900150,
   "version": 1,
   "versionNonce": 900151,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "fillStyle": "solid",
   "backgroundColor": "transparent",
   "strokeWidth": 1,
   "x": 100,
   "y": 912,
   "width": 1233.18,
   "height": 16.25,
   "text": "Sixteen event types are emitted; three more are declared and dormant, and StepProgressEvent has no fixed type. Each row names its emitter with file:line.",
   "originalText": "Sixteen event types are emitted; three more are declared and dormant, and StepProgressEvent has no fixed type. Each row names its emitter with file:line.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#64748b",
   "containerId": null,
   "lineHeight": 1.25
  }
