    { "type": "text", "id": "store_t", "x": 84, "y": 336, "width": 1272, "height": 120,
      "text": "What survives between the two runs, in the context\n\n  StepResults          StepA and StepB only  -  StepC is absent, because it never finished\n  Metadata[state]      what StepC's SaveStateAsync returned\n  PipelineSuspendedEvent   TargetStepPath, IsBranchSuspension, BranchName",
      "originalText": "What survives between the two runs, in the context\n\n  StepResults          StepA and StepB only  -  StepC is absent, because it never finished\n  Metadata[state]      what StepC's SaveStateAsync returned\n  PipelineSuspendedEvent   TargetStepPath, IsBranchSuspension, BranchName",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 150025, "version": 1, "versionNonce": 150026, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

