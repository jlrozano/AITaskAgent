    { "type": "rectangle", "id": "rule", "x": 60, "y": 670, "width": 1320, "height": 116,
      "strokeColor": "#047857", "backgroundColor": "#ecfdf5", "fillStyle": "solid",
      "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 150055, "version": 1, "versionNonce": 150056, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "rule_t", "x": 84, "y": 688, "width": 1272, "height": 80,
      "text": "The rule that makes the skipping safe\nA result is cached only after the step AND all of its NextSteps have succeeded. StepA and StepB are\nin the cache because they are genuinely done; StepC is not, so it runs again rather than being skipped.",
      "originalText": "The rule that makes the skipping safe\nA result is cached only after the step AND all of its NextSteps have succeeded. StepA and StepB are\nin the cache because they are genuinely done; StepC is not, so it runs again rather than being skipped.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 150057, "version": 1, "versionNonce": 150058, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "code_h", "x": 1440, "y": 512, "width": 700, "height": 22,
      "text": "What a suspending step returns",
      "originalText": "What a suspending step returns", "fontSize": 17, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150059,
      "version": 1, "versionNonce": 150060, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "containerId": null,
      "lineHeight": 1.25 },
    { "type": "rectangle", "id": "code", "x": 1440, "y": 548, "width": 700, "height": 122,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 150061, "version": 1, "versionNonce": 150062, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "code_t", "x": 1460, "y": 564, "width": 660, "height": 90,
      "text": "new SuspendStepResult(this, state: _draft)\n{\n    SuspendInfo  = \"awaiting-approval\",\n    DataToReview = _draft\n}",
      "originalText": "new SuspendStepResult(this, state: _draft)\n{\n    SuspendInfo  = \"awaiting-approval\",\n    DataToReview = _draft\n}",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 150063, "version": 1, "versionNonce": 150064, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "throw", "x": 1440, "y": 690, "width": 700, "height": 96,
      "strokeColor": "#dc2626", "backgroundColor": "#fee2e2", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 150065, "version": 1, "versionNonce": 150066, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "throw_t", "x": 1462, "y": 706, "width": 656, "height": 60,
      "text": "SuspendInfo without IResume throws\nThe engine refuses a step that asks to suspend but\ncannot save or restore itself. Fail loud, not halfway.",
      "originalText": "SuspendInfo without IResume throws\nThe engine refuses a step that asks to suspend but\ncannot save or restore itself. Fail loud, not halfway.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#991b1b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 150067, "version": 1, "versionNonce": 150068, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "lim_h", "x": 60, "y": 820, "width": 900, "height": 22,
      "text": "Three limits to know before building on this",
      "originalText": "Three limits to know before building on this", "fontSize": 17,
      "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 150069,
      "version": 1, "versionNonce": 150070, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "containerId": null,
      "lineHeight": 1.25 },
    { "type": "text", "id": "lim_t", "x": 60, "y": 854, "width": 2080, "height": 76,
      "text": "Persisting the context is your job.   Nothing calls IPipelineContextStorage.SaveAsync; the framework only reads, through CreateFromId.\nResumeRequest is not wired up.       The type describes the right shape, but no code path consumes it. You pass the answer as the pipeline input.\nThe correlation id is generated.     Create() always mints a new Guid, so you read it after the fact rather than keying a resume off a business id.",
      "originalText": "Persisting the context is your job.   Nothing calls IPipelineContextStorage.SaveAsync; the framework only reads, through CreateFromId.\nResumeRequest is not wired up.       The type describes the right shape, but no code path consumes it. You pass the answer as the pipeline input.\nThe correlation id is generated.     Create() always mints a new Guid, so you read it after the fact rather than keying a resume off a business id.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 150071, "version": 1, "versionNonce": 150072, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "foot", "x": 60, "y": 950, "width": 2080, "height": 19,
      "text": "A run is treated as a resume for exactly one reason: ResumeStateKey is present in Metadata. Verified against Pipeline.cs and StepBase.cs.",
      "originalText": "A run is treated as a resume for exactly one reason: ResumeStateKey is present in Metadata. Verified against Pipeline.cs and StepBase.cs.",
