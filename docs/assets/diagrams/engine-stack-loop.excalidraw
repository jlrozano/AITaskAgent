  {
   "type": "text",
   "id": "ctx_t",
   "x": 1544,
   "y": 190,
   "width": 740,
   "height": 270,
   "text": "StepResults      the cache, keyed by step path\nMetadata         suspension state and the pending answer\nConversation     LLM history, cloned per parallel branch\nCorrelationId    routes events to one subscriber\nCurrentStepPath  \"Loop/Iter_2/Draft\"\nRuntime          the engine itself, attached on entry\nServiceProvider  scoped resolution from inside a step\nEventChannel     SendEventAsync",
   "originalText": "StepResults      the cache, keyed by step path\nMetadata         suspension state and the pending answer\nConversation     LLM history, cloned per parallel branch\nCorrelationId    routes events to one subscriber\nCurrentStepPath  \"Loop/Iter_2/Draft\"\nRuntime          the engine itself, attached on entry\nServiceProvider  scoped resolution from inside a step\nEventChannel     SendEventAsync",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
