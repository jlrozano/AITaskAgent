  {
   "type": "text",
   "id": "warn_t",
   "x": 1544,
   "y": 410,
   "width": 740,
   "height": 60,
   "text": "Cycles are not prevented\nA step that adds itself to NextSteps loops forever. The graph is acyclic\nby convention, not by any check in the engine.",
   "originalText": "Cycles are not prevented\nA step that adds itself to NextSteps loops forever. The graph is acyclic\nby convention, not by any check in the engine.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#991b1b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 120083,
   "version": 1,
   "versionNonce": 120084,
   "isDeleted": false,
