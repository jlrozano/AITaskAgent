  },
  {
   "type": "text",
   "id": "ctx_note",
   "x": 1520,
   "y": 518,
   "width": 780,
   "height": 114,
   "text": "The step path is what keeps the cache honest. A loop pushes\n\"{Name}/Iter_{n}\", a parallel branch gets its own prefix, so two\nruns of the same step under different parents never collide,\nand a resume re-enters the exact iteration that suspended\nrather than restarting the loop.",
   "originalText": "The step path is what keeps the cache honest. A loop pushes\n\"{Name}/Iter_{n}\", a parallel branch gets its own prefix, so two\nruns of the same step under different parents never collide,\nand a resume re-enters the exact iteration that suspended\nrather than restarting the loop.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
