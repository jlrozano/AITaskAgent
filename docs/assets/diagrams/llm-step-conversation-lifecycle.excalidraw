      "lineHeight": 1.25 },

    { "type": "rectangle", "id": "ok", "x": 60, "y": 936, "width": 930, "height": 116,
      "strokeColor": "#047857", "backgroundColor": "#ecfdf5", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 170079, "version": 1, "versionNonce": 170080, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "ok_t", "x": 82, "y": 954, "width": 886, "height": 80,
      "text": "On success\nExactly one user message and one assistant message, as if the\nmodel had answered correctly the first time. Every mid-retry\nexchange is gone.",
      "originalText": "On success\nExactly one user message and one assistant message, as if the\nmodel had answered correctly the first time. Every mid-retry\nexchange is gone.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#065f46", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 170081, "version": 1, "versionNonce": 170082, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "bad", "x": 1030, "y": 936, "width": 930, "height": 116,
      "strokeColor": "#dc2626", "backgroundColor": "#fef2f2", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 170083, "version": 1, "versionNonce": 170084, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "bad_t", "x": 1052, "y": 954, "width": 886, "height": 80,
      "text": "On failure\nNothing at all. Not the assistant attempts, not the error text,\nnot even the user message. The bookmark is restored and no\npair is written, so the turn leaves no trace.",
      "originalText": "On failure\nNothing at all. Not the assistant attempts, not the error text,\nnot even the user message. The bookmark is restored and no\npair is written, so the turn leaves no trace.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#991b1b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 170085, "version": 1, "versionNonce": 170086, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "foot", "x": 60, "y": 1072, "width": 2000, "height": 38,
      "text": "A fallback switch rewinds the same way, so a new provider never inherits the previous one's failed exchange.\nVerified against BaseLlmStep.ExecuteAsync, FinalizeAsync and SwitchToNextFallback.",
      "originalText": "A fallback switch rewinds the same way, so a new provider never inherits the previous one's failed exchange.\nVerified against BaseLlmStep.ExecuteAsync, FinalizeAsync and SwitchToNextFallback.",
