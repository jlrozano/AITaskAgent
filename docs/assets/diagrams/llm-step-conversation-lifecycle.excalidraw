    { "type": "text", "id": "outcome_h", "x": 60, "y": 900, "width": 900, "height": 22,
      "text": "What the history holds afterwards",
      "originalText": "What the history holds afterwards", "fontSize": 17, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af",
