    { "type": "text", "id": "title", "x": 60, "y": 40, "width": 1400, "height": 38,
      "text": "The tool loop, and the three ways out of it",
      "originalText": "The tool loop, and the three ways out of it",
      "fontSize": 30, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 180001, "version": 1, "versionNonce": 180002, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 60, "y": 86, "width": 1900, "height": 20,
      "text": "A model can keep asking for tools indefinitely. Two guards stop that, and they behave differently depending on what the tools do.",
      "originalText": "A model can keep asking for tools indefinitely. Two guards stop that, and they behave differently depending on what the tools do.",
