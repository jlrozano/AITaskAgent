    { "type": "text", "id": "l_yes1", "x": 900, "y": 282, "width": 80, "height": 17,
      "text": "yes", "originalText": "yes", "fontSize": 12, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top", "strokeColor": "#b91c1c",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
