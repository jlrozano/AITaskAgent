      "roundness": {"type": 3} },
    { "type": "text", "id": "in1_t", "x": 100, "y": 176, "width": 480, "height": 208,
      "text": "- !LlmStep\n    stepId: step_2_extract\n    inputSchema: ClassificationOutput\n    outputSchema: ExtractionOutput\n    profileName: default\n    systemPrompt: \"@extractor\"\n    userPrompt: |\n      Document type: {{inputData.type}}\n      Extract the key fields.\n    dependsOn: [step_1_classify]",
      "originalText": "- !LlmStep\n    stepId: step_2_extract\n    inputSchema: ClassificationOutput\n    outputSchema: ExtractionOutput\n    profileName: default\n    systemPrompt: \"@extractor\"\n    userPrompt: |\n      Document type: {{inputData.type}}\n      Extract the key fields.\n    dependsOn: [step_1_classify]",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 250007, "version": 1, "versionNonce": 250008, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "in2", "x": 80, "y": 420, "width": 520, "height": 210,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
