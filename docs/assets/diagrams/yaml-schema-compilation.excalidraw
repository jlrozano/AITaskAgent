  {
   "type": "text",
   "id": "why_t",
   "angle": 0,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "seed": 900042,
   "version": 1,
   "versionNonce": 900043,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "fillStyle": "solid",
   "backgroundColor": "transparent",
   "strokeWidth": 1,
   "x": 1418,
   "y": 445.5,
   "width": 484,
   "height": 113.75,
   "text": "Why bother compiling\n\nThe engine, the middleware, the retry validation\nand the telemetry all see the same strongly typed\nresult whether the step was written in C# or\ndeclared in YAML. Nothing downstream has a special\npath for dynamic steps, because there are none.",
   "originalText": "Why bother compiling\n\nThe engine, the middleware, the retry validation\nand the telemetry all see the same strongly typed\nresult whether the step was written in C# or\ndeclared in YAML. Nothing downstream has a special\npath for dynamic steps, because there are none.",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#374151",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "rectangle",
   "id": "js",
