    { "type": "text", "id": "title", "x": 60, "y": 40, "width": 1600, "height": 38,
      "text": "YAML becomes real C# types before anything runs",
      "originalText": "YAML becomes real C# types before anything runs",
      "fontSize": 30, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 250001, "version": 1, "versionNonce": 250002, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 60, "y": 86, "width": 2000, "height": 20,
      "text": "The obvious way to build a dynamic pipeline is to pass a JObject around. This engine compiles instead, so a YAML step and a C# step are indistinguishable downstream.",
      "originalText": "The obvious way to build a dynamic pipeline is to pass a JObject around. This engine compiles instead, so a YAML step and a C# step are indistinguishable downstream.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 250003, "version": 1, "versionNonce": 250004, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "in1", "x": 80, "y": 160, "width": 520, "height": 240,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 250005, "version": 1, "versionNonce": 250006, "isDeleted": false,
