   "text": "- !LlmStep\n    stepId: step_2_extract\n    inputSchema: ClassificationOutput\n    outputSchema: ExtractionOutput\n    profileName: default\n    systemPrompt: \"@[prompts/extractor.md]\"\n    userPrompt: |\n      Document type: {{input.type}}\n      Extract the relevant key fields.\n    dependsOn: [step_1_classify]",
