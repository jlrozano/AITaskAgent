    { "type": "text", "id": "in2_t", "x": 100, "y": 436, "width": 480, "height": 178,
      "text": "{\n  \"title\": \"ClassificationOutput\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"content\":    { \"type\": \"string\" },\n    \"type\":       { \"type\": \"string\" },\n    \"confidence\": { \"type\": \"number\" }\n  },\n  \"required\": [\"content\",\"type\",\"confidence\"]\n}",
      "originalText": "{\n  \"title\": \"ClassificationOutput\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"content\":    { \"type\": \"string\" },\n    \"type\":       { \"type\": \"string\" },\n    \"confidence\": { \"type\": \"number\" }\n  },\n  \"required\": [\"content\",\"type\",\"confidence\"]\n}",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 250011, "version": 1, "versionNonce": 250012, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
