    { "type": "text", "id": "more_h", "x": 80, "y": 770, "width": 900, "height": 22,
      "text": "Then there is the rest, each with its own diagram",
      "originalText": "Then there is the rest, each with its own diagram", "fontSize": 17,
      "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af",
