  {
   "type": "text",
   "id": "me_t",
   "x": 682,
   "y": 344,
   "width": 436,
   "height": 130.0,
   "text": "Metrics.Meter  \"AITaskAgent.Pipeline\"\n12 counters and histograms, all prefixed\naitaskagent.\n\n  pipeline.executions  .duration\n  step.executions  .errors  .retries  .duration\n  llm.requests  .tokens  .cost  .duration\n  tool.executions  .duration",
   "originalText": "Metrics.Meter  \"AITaskAgent.Pipeline\"\n12 counters and histograms, all prefixed\naitaskagent.\n\n  pipeline.executions  .duration\n  step.executions  .errors  .retries  .duration\n  llm.requests  .tokens  .cost  .duration\n  tool.executions  .duration",
