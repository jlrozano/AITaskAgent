    { "type": "text", "id": "title", "x": 60, "y": 40, "width": 1400, "height": 38,
      "text": "One channel, many runs, one buffer per subscriber",
      "originalText": "One channel, many runs, one buffer per subscriber",
      "fontSize": 30, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 210001, "version": 1, "versionNonce": 210002, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 60, "y": 86, "width": 1900, "height": 20,
      "text": "The channel is a singleton shared by every concurrent run. The correlation id is what stops one request seeing another's events.",
      "originalText": "The channel is a singleton shared by every concurrent run. The correlation id is what stops one request seeing another's events.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
