    { "type": "rectangle", "id": "drop", "x": 80, "y": 580, "width": 1760, "height": 150,
      "strokeColor": "#dc2626", "backgroundColor": "#fee2e2", "fillStyle": "solid",
      "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 210051, "version": 1, "versionNonce": 210052, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "drop_t", "x": 104, "y": 598, "width": 1712, "height": 114,
      "text": "Events are not guaranteed to arrive\nEvery subscriber gets its own bounded buffer, created with BoundedChannelFullMode.DropOldest and a default\ncapacity of 100. A subscriber that cannot keep up silently loses its oldest events; all you get is a\n\"Subscriber channel full, event dropped\" log line. Treat events as progress reporting, never as an audit trail\nor a source of truth. If you need every one of them, drain the subscription faster than the run produces it.",
      "originalText": "Events are not guaranteed to arrive\nEvery subscriber gets its own bounded buffer, created with BoundedChannelFullMode.DropOldest and a default\ncapacity of 100. A subscriber that cannot keep up silently loses its oldest events; all you get is a\n\"Subscriber channel full, event dropped\" log line. Treat events as progress reporting, never as an audit trail\nor a source of truth. If you need every one of them, drain the subscription faster than the run produces it.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#991b1b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 210053, "version": 1, "versionNonce": 210054, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "ways_h", "x": 80, "y": 760, "width": 900, "height": 22,
      "text": "Three ways to subscribe",
      "originalText": "Three ways to subscribe", "fontSize": 17, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 210055,
      "version": 1, "versionNonce": 210056, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "containerId": null,
      "lineHeight": 1.25 },
    { "type": "text", "id": "ways_t", "x": 80, "y": 794, "width": 1900, "height": 76,
      "text": "Subscribe(handler, id)          a background consumer runs your callback; returns IDisposable\nCreateSubscription(cap, id)      you drive it with await foreach  -  the natural fit for SSE or a WebSocket\nsubscribers: [...] on ExecuteAsync  per-run handlers, wired for the lifetime of that one call\n\nA closed subscriber channel is dropped from the list on the next send, so a disposed subscription cleans itself up.",
      "originalText": "Subscribe(handler, id)          a background consumer runs your callback; returns IDisposable\nCreateSubscription(cap, id)      you drive it with await foreach  -  the natural fit for SSE or a WebSocket\nsubscribers: [...] on ExecuteAsync  per-run handlers, wired for the lifetime of that one call\n\nA closed subscriber channel is dropped from the list on the next send, so a disposed subscription cleans itself up.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 210057, "version": 1, "versionNonce": 210058, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "foot", "x": 80, "y": 900, "width": 1900, "height": 19,
      "text": "AITaskAgent:Observability:EventChannelCapacity is bound from configuration but never wired: the capacity comes from the call. Verified against EventChannel.cs.",
      "originalText": "AITaskAgent:Observability:EventChannelCapacity is bound from configuration but never wired: the capacity comes from the call. Verified against EventChannel.cs.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 210059, "version": 1, "versionNonce": 210060, "isDeleted": false,
