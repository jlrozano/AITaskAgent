  {
   "type": "text",
   "id": "key",
   "x": 310,
   "y": 840,
   "width": 900,
   "height": 35.0,
   "text": "The observability happens either way: the tail runs in a finally, so a tool that throws is still counted,\ntimed, and still sends a ToolCompletedEvent with Success = false before the exception reaches the step.",
   "originalText": "The observability happens either way: the tail runs in a finally, so a tool that throws is still counted,\ntimed, and still sends a ToolCompletedEvent with Success = false before the exception reaches the step.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 190047,
   "version": 1,
   "versionNonce": 190048,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "rectangle",
   "id": "cmp",
   "x": 1320,
   "y": 180,
   "width": 900,
   "height": 290,
   "strokeColor": "#b45309",
   "backgroundColor": "#fffbeb",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
