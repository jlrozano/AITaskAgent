   }
  },
  {
   "type": "text",
   "id": "tags_t",
   "x": 1344,
   "y": 518,
   "width": 856,
   "height": 210.0,
   "text": "What the activity carries\n\n  Tool.<name>        the span name\n  tool.name          which tool ran\n  step.name          which step asked for it\n  correlation.id     ties it to the run\n  tool.duration_ms   how long it took\n  tool.success       true or false\n\nEnrichActivityBefore and After are where you add\nyour own tags without touching the flow. The last\ntwo tags are set after EnrichActivityAfter runs.",
   "originalText": "What the activity carries\n\n  Tool.<name>        the span name\n  tool.name          which tool ran\n  step.name          which step asked for it\n  correlation.id     ties it to the run\n  tool.duration_ms   how long it took\n  tool.success       true or false\n\nEnrichActivityBefore and After are where you add\nyour own tags without touching the flow. The last\ntwo tags are set after EnrichActivityAfter runs.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 190055,
   "version": 1,
   "versionNonce": 190056,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "foot",
   "x": 60,
   "y": 900,
