    { "type": "text", "id": "title", "x": 60, "y": 40, "width": 1400, "height": 38,
      "text": "ParallelStep: what is cloned, what is shared",
      "originalText": "ParallelStep: what is cloned, what is shared",
      "fontSize": 30, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 140001, "version": 1, "versionNonce": 140002, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 60, "y": 86, "width": 1800, "height": 20,
      "text": "The isolation is partial, and knowing exactly where the line falls is the difference between a safe fan-out and a data race.",
      "originalText": "The isolation is partial, and knowing exactly where the line falls is the difference between a safe fan-out and a data race.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 140003, "version": 1, "versionNonce": 140004, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

