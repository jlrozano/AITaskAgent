    { "type": "text", "id": "err_t", "x": 182, "y": 758, "width": 556, "height": 98,
      "text": "A failing branch does not stop the others\nErrors are collected into a ConcurrentBag and joined\ninto a single StepError on the ParallelResult once every\nbranch has finished. So a fan-out either completes or\nreports all of its failures at once, never half of them.",
      "originalText": "A failing branch does not stop the others\nErrors are collected into a ConcurrentBag and joined\ninto a single StepError on the ParallelResult once every\nbranch has finished. So a fan-out either completes or\nreports all of its failures at once, never half of them.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 140045, "version": 1, "versionNonce": 140046, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "gotcha", "x": 1280, "y": 740, "width": 600, "height": 130,
      "strokeColor": "#dc2626", "backgroundColor": "#fee2e2", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 140047, "version": 1, "versionNonce": 140048, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "gotcha_t", "x": 1302, "y": 758, "width": 556, "height": 98,
      "text": "The trap\nTwo branches writing the same Metadata key both\nsucceed, and the last one wins. Thread-safe means no\ncorruption, not no conflict. Give each branch its own key,\nor keep per-branch data in its result instead.",
      "originalText": "The trap\nTwo branches writing the same Metadata key both\nsucceed, and the last one wins. Thread-safe means no\ncorruption, not no conflict. Give each branch its own key,\nor keep per-branch data in its result instead.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#991b1b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 140049, "version": 1, "versionNonce": 140050, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "note_branches", "x": 60, "y": 114, "width": 1900, "height": 19,
      "text": "The collection is called Branches, not Steps  -  and every branch still runs through the full middleware chain.",
      "originalText": "The collection is called Branches, not Steps  -  and every branch still runs through the full middleware chain.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
