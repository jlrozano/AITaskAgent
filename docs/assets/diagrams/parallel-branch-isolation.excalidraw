    { "type": "text", "id": "bC_t", "x": 1362, "y": 288, "width": 496, "height": 175,
      "text": "Branch C\n\nA branch may suspend on its\nown. The suspension is marked\nIsBranchSuspension with its\nBranchName, and the other\nbranches carry on undisturbed.",
      "originalText": "Branch C\n\nA branch may suspend on its\nown. The suspension is marked\nIsBranchSuspension with its\nBranchName, and the other\nbranches carry on undisturbed.",
