    { "type": "text", "id": "bA_t", "x": 182, "y": 288, "width": 496, "height": 175,
      "text": "Branch A\n\nCloneForBranch() gives it:\n\n  Conversation.Clone()\n  a fresh step path\n  its own BranchId (a Guid)\n\nEmits BranchStartedEvent\nand BranchCompletedEvent.",
      "originalText": "Branch A\n\nCloneForBranch() gives it:\n\n  Conversation.Clone()\n  a fresh step path\n  its own BranchId (a Guid)\n\nEmits BranchStartedEvent\nand BranchCompletedEvent.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 140011, "version": 1, "versionNonce": 140012, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "bB", "x": 750, "y": 270, "width": 540, "height": 210,
      "strokeColor": "#6d28d9", "backgroundColor": "#f5f3ff", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 140013, "version": 1, "versionNonce": 140014, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "bB_t", "x": 772, "y": 288, "width": 496, "height": 175,
      "text": "Branch B\n\nSame deal, independently.\n\nBecause each branch talks to\nits own copy of the history, two\nbranches prompting a model\ncannot corrupt each other's\nconversation.",
      "originalText": "Branch B\n\nSame deal, independently.\n\nBecause each branch talks to\nits own copy of the history, two\nbranches prompting a model\ncannot corrupt each other's\nconversation.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 140015, "version": 1, "versionNonce": 140016, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "bC", "x": 1340, "y": 270, "width": 540, "height": 210,
