    { "type": "text", "id": "a_retry_lbl", "x": 790, "y": 480, "width": 180, "height": 57,
      "text": "attempt++\nfeedback rides in\nas lastResult",
      "originalText": "attempt++\nfeedback rides in\nas lastResult", "fontSize": 13,
      "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#dc2626",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110045,
      "version": 1, "versionNonce": 110046, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "containerId": null,
      "lineHeight": 1.25 },
    { "type": "text", "id": "a_fail_lbl", "x": 220, "y": 738, "width": 540, "height": 38,
      "text": "Any of the three failing paths re-enters the loop; the error text becomes\nthe next attempt's lastResult, which is how a model corrects itself.",
      "originalText": "Any of the three failing paths re-enters the loop; the error text becomes\nthe next attempt's lastResult, which is how a model corrects itself.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
