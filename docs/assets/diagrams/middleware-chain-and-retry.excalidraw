    { "type": "text", "id": "L0_t", "x": 80, "y": 162, "width": 600, "height": 19,
      "text": "User middlewares            await next()",
      "originalText": "User middlewares            await next()",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
