      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "L1_t", "x": 120, "y": 224, "width": 700, "height": 19,
      "text": "ObservabilityMiddleware     await next()   -  runs exactly once per step",
      "originalText": "ObservabilityMiddleware     await next()   -  runs exactly once per step",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110015, "version": 1, "versionNonce": 110016, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "L2_t", "x": 160, "y": 286, "width": 780, "height": 19,
      "text": "TimeoutMiddleware           await next(cts.Token)  -  one budget for all attempts",
      "originalText": "TimeoutMiddleware           await next(cts.Token)  -  one budget for all attempts",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110017, "version": 1, "versionNonce": 110018, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "L3_t", "x": 200, "y": 348, "width": 800, "height": 38,
      "text": "RetryMiddleware             never calls next()\nwhile (attempt <= step.MaxRetries)",
      "originalText": "RetryMiddleware             never calls next()\nwhile (attempt <= step.MaxRetries)",
