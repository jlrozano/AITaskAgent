    { "type": "text", "id": "title", "x": 60, "y": 40, "width": 1200, "height": 38,
      "text": "The middleware chain, and why Retry is different",
      "originalText": "The middleware chain, and why Retry is different",
      "fontSize": 30, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110001, "version": 1, "versionNonce": 110002, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 60, "y": 86, "width": 1500, "height": 20,
      "text": "Every middleware wraps next(). Retry does not: it calls the step itself, so its attempts happen inside one Observability call.",
      "originalText": "Every middleware wraps next(). Retry does not: it calls the step itself, so its attempts happen inside one Observability call.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110003, "version": 1, "versionNonce": 110004, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

