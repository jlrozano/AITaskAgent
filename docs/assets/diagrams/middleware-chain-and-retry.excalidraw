    { "type": "text", "id": "em1_t", "x": 1242, "y": 204, "width": 1040, "height": 90,
      "text": "Observability      Activity Step.<name>, opened and closed once\n                   StepStartedEvent    AttemptNumber = 1 only\n                   StepCompletedEvent\n                   StepExecutions, StepDuration, StepErrors",
      "originalText": "Observability      Activity Step.<name>, opened and closed once\n                   StepStartedEvent    AttemptNumber = 1 only\n                   StepCompletedEvent\n                   StepExecutions, StepDuration, StepErrors",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
