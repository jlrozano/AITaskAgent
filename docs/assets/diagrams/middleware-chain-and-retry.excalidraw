    { "type": "text", "id": "why_h", "x": 1220, "y": 522, "width": 900, "height": 22,
      "text": "The two consequences of that nesting",
      "originalText": "The two consequences of that nesting", "fontSize": 17, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110063,
      "version": 1, "versionNonce": 110064, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "containerId": null,
      "lineHeight": 1.25 },

    { "type": "rectangle", "id": "why1", "x": 1220, "y": 556, "width": 1080, "height": 76,
      "strokeColor": "#1e40af", "backgroundColor": "#dbeafe", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110065, "version": 1, "versionNonce": 110066, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "why1_t", "x": 1242, "y": 572, "width": 1040, "height": 48,
      "text": "Retries are invisible to Observability, so it cannot number them. That is why two\ndifferent middlewares emit StepStartedEvent for the same step.",
      "originalText": "Retries are invisible to Observability, so it cannot number them. That is why two\ndifferent middlewares emit StepStartedEvent for the same step.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110067, "version": 1, "versionNonce": 110068, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "why2", "x": 1220, "y": 646, "width": 1080, "height": 76,
      "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110069, "version": 1, "versionNonce": 110070, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "why2_t", "x": 1242, "y": 662, "width": 1040, "height": 48,
      "text": "Timeout wraps the whole loop, so with MaxRetries = N and Timeout = T the worst\ncase is T, not N x T. A slow first attempt can starve the rest.",
      "originalText": "Timeout wraps the whole loop, so with MaxRetries = N and Timeout = T the worst\ncase is T, not N x T. A slow first attempt can starve the rest.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110071, "version": 1, "versionNonce": 110072, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "exit_h", "x": 1220, "y": 756, "width": 900, "height": 22,
      "text": "Four ways out of the loop",
      "originalText": "Four ways out of the loop", "fontSize": 17, "fontFamily": 3,
      "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e40af",
      "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 110073,
      "version": 1, "versionNonce": 110074, "isDeleted": false, "groupIds": [],
      "boundElements": null, "link": null, "locked": false, "containerId": null,
      "lineHeight": 1.25 },
    { "type": "text", "id": "exit_t", "x": 1220, "y": 790, "width": 1080, "height": 158,
      "text": "valid result            FinalizeAsync, return it\nexception thrown        fatal, no retry   -  fallback is tried first\nerror + OriginalException  fatal, no retry   -  fallback is tried first\nerror, no exception     recoverable, retry with the message as feedback\nattempts exhausted      \"Validation failed after N attempts\"",
      "originalText": "valid result            FinalizeAsync, return it\nexception thrown        fatal, no retry   -  fallback is tried first\nerror + OriginalException  fatal, no retry   -  fallback is tried first\nerror, no exception     recoverable, retry with the message as feedback\nattempts exhausted      \"Validation failed after N attempts\"",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110075, "version": 1, "versionNonce": 110076, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "order", "x": 1220, "y": 856, "width": 1080, "height": 90,
      "strokeColor": "#94a3b8", "backgroundColor": "#f8fafc", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110079, "version": 1, "versionNonce": 110080, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "order_t", "x": 1242, "y": 872, "width": 1040, "height": 62,
      "text": "Your middlewares go on the outside, once, at composition time:\n  PipelineMiddlewareRegistry.Register(...)  or  RegisterPipelineMiddleware<T>()\nThey are never passed per call, and they can never get inside Retry.",
      "originalText": "Your middlewares go on the outside, once, at composition time:\n  PipelineMiddlewareRegistry.Register(...)  or  RegisterPipelineMiddleware<T>()\nThey are never passed per call, and they can never get inside Retry.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110081, "version": 1, "versionNonce": 110082, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "foot", "x": 60, "y": 985, "width": 2240, "height": 38,
      "text": "There is no backoff delay between attempts: the feedback loop, not waiting, is what is expected to fix the failure. A successful fallback\nswitch resets attempt to 1, so a fresh provider gets its full budget. Verified against RetryMiddleware.cs, ObservabilityMiddleware.cs, TimeoutMiddleware.cs.",
      "originalText": "There is no backoff delay between attempts: the feedback loop, not waiting, is what is expected to fix the failure. A successful fallback\nswitch resets attempt to 1, so a fresh provider gets its full budget. Verified against RetryMiddleware.cs, ObservabilityMiddleware.cs, TimeoutMiddleware.cs.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 110077, "version": 1, "versionNonce": 110078, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
