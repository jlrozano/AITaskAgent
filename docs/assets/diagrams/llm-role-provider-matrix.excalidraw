    { "type": "text", "id": "s3_anom_h", "x": 1650, "y": 1000, "width": 700, "height": 20,
      "text": "Three things worth knowing", "originalText": "Three things worth knowing",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
