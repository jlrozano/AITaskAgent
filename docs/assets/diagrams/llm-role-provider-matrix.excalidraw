    { "type": "text", "id": "s1_legend", "x": 230, "y": 522, "width": 860, "height": 18,
      "text": "solid = the role's own Provider/Model      dashed = a fallback entry",
      "originalText": "solid = the role's own Provider/Model      dashed = a fallback entry",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200039, "version": 1, "versionNonce": 200040, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "s1_json", "x": 60, "y": 574, "width": 430, "height": 296,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200041, "version": 1, "versionNonce": 200042, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "s1_json_t", "x": 78, "y": 590, "width": 394, "height": 264,
      "text": "\"Roles\": {\n  \"default\": {\n    \"Provider\": \"Gemini\",\n    \"Model\": \"gemini-2.5-flash\"\n  },\n  \"thinking\": {\n    \"Provider\": \"OpenRouter\",\n    \"Model\": \"minimax/minimax-m2.5:free\",\n    \"Fallbacks\": [\n      { \"Provider\": \"Groq\", \"Model\": \"qwen/qwen3-32b\" }\n    ]\n  }\n},\n\"FallbackProviders\": [\n  { \"Provider\": \"OpenRouter\", \"Model\": \"gpt-4o-mini\" }\n]",
      "originalText": "\"Roles\": {\n  \"default\": {\n    \"Provider\": \"Gemini\",\n    \"Model\": \"gemini-2.5-flash\"\n  },\n  \"thinking\": {\n    \"Provider\": \"OpenRouter\",\n    \"Model\": \"minimax/minimax-m2.5:free\",\n    \"Fallbacks\": [\n      { \"Provider\": \"Groq\", \"Model\": \"qwen/qwen3-32b\" }\n    ]\n  }\n},\n\"FallbackProviders\": [\n  { \"Provider\": \"OpenRouter\", \"Model\": \"gpt-4o-mini\" }\n]",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200043, "version": 1, "versionNonce": 200044, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "s1_note1", "x": 520, "y": 592, "width": 570, "height": 76,
      "text": "default declares no Fallbacks, so it silently\ninherits the environment-level list.\nThat is the dashed cell in its row.",
      "originalText": "default declares no Fallbacks, so it silently\ninherits the environment-level list.\nThat is the dashed cell in its row.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200045, "version": 1, "versionNonce": 200046, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "s1_note2", "x": 520, "y": 690, "width": 570, "height": 76,
      "text": "thinking declares its own Fallbacks, so the\nglobal list does not apply to it at all.\nThe two lists never merge.",
      "originalText": "thinking declares its own Fallbacks, so the\nglobal list does not apply to it at all.\nThe two lists never merge.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200047, "version": 1, "versionNonce": 200048, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "s1_note3", "x": 520, "y": 788, "width": 570, "height": 57,
      "text": "A role holds a resolved LlmProvider object,\nnot a provider name. The name only exists\nwhile configuration is being bound.",
      "originalText": "A role holds a resolved LlmProvider object,\nnot a provider name. The name only exists\nwhile configuration is being bound.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 200049, "version": 1, "versionNonce": 200050, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

