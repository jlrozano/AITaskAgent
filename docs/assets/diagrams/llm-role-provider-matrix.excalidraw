    { "type": "text", "id": "s2_note_share", "x": 1950, "y": 428, "width": 400, "height": 95,
      "text": "One service, many providers.\nOpenRouter, Groq and Ollama all\ndeclare ServiceType \"openai\", so the\nsame ILlmService serves all three.",
      "originalText": "One service, many providers.\nOpenRouter, Groq and Ollama all\ndeclare ServiceType \"openai\", so the\nsame ILlmService serves all three.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#3b82f6", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300045, "version": 1, "versionNonce": 300046, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "s2_note_omit", "x": 1950, "y": 552, "width": 400, "height": 76,
      "text": "Omit ServiceType and the provider key\nbecomes the service name, so a provider\nkeyed Gemini looks for a service named\ngemini.",
      "originalText": "Omit ServiceType and the provider key\nbecomes the service name, so a provider\nkeyed Gemini looks for a service named\ngemini.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300053, "version": 1, "versionNonce": 300054, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "s2_err", "x": 1250, "y": 690, "width": 700, "height": 118,
      "strokeColor": "#1e293b", "backgroundColor": "#1e293b", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300047, "version": 1, "versionNonce": 300048, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "s2_err_t", "x": 1270, "y": 700, "width": 660, "height": 98,
      "text": "LLM provider 'Gemini' requests service type\n'gemini', but no matching ILlmService is\nregistered. Registered services: openai.\nRegister the provider's service, or correct\nthe 'ServiceType' value.",
      "originalText": "LLM provider 'Gemini' requests service type\n'gemini', but no matching ILlmService is\nregistered. Registered services: openai.\nRegister the provider's service, or correct\nthe 'ServiceType' value.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#fca5a5", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300049, "version": 1, "versionNonce": 300050, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "s2_note_why", "x": 1990, "y": 700, "width": 380, "height": 98,
      "text": "Silently sending a prompt to a\ndifferent vendor than the one\nconfigured is worse than refusing\nto start. Eight configuration\nmistakes fail this way, at startup.",
      "originalText": "Silently sending a prompt to a\ndifferent vendor than the one\nconfigured is worse than refusing\nto start. Eight configuration\nmistakes fail this way, at startup.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 300051, "version": 1, "versionNonce": 300052, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

