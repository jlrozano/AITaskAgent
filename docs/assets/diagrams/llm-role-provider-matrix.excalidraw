      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "s3_sub", "x": 60, "y": 954, "width": 1400, "height": 18,
      "text": "LlmInferenceSettings is a facade over one JObject, so every knob travels in Options and the merge is field by field.",
      "originalText": "LlmInferenceSettings is a facade over one JObject, so every knob travels in Options and the merge is field by field.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
