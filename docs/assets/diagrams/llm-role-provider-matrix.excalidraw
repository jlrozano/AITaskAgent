    { "type": "rectangle", "id": "s3_an1", "x": 1650, "y": 1030, "width": 700, "height": 62,
      "strokeColor": "#dc2626", "backgroundColor": "#fee2e2", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400039, "version": 1, "versionNonce": 400040, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "s3_an1_t", "x": 1670, "y": 1043, "width": 660, "height": 38,
      "text": "Models[].Inference is dead configuration. Models feeds CalculateCost\nand nothing else, so per-model inference settings are silently ignored.",
      "originalText": "Models[].Inference is dead configuration. Models feeds CalculateCost\nand nothing else, so per-model inference settings are silently ignored.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400041, "version": 1, "versionNonce": 400042, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "s3_an2", "x": 1650, "y": 1106, "width": 700, "height": 62,
      "strokeColor": "#dc2626", "backgroundColor": "#fee2e2", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400043, "version": 1, "versionNonce": 400044, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "s3_an2_t", "x": 1670, "y": 1119, "width": 660, "height": 32,
      "text": "JsonSupport is read from the provider, not the role, so a role cannot\nturn structured output on for one step. BaseLlmStep.cs:600.",
      "originalText": "JsonSupport is read from the provider, not the role, so a role cannot\nturn structured output on for one step. BaseLlmStep.cs:600.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400045, "version": 1, "versionNonce": 400046, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "s3_an3", "x": 1650, "y": 1182, "width": 700, "height": 62,
      "strokeColor": "#1e3a5f", "backgroundColor": "#dbeafe", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400047, "version": 1, "versionNonce": 400048, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "s3_an3_t", "x": 1670, "y": 1195, "width": 660, "height": 38,
      "text": "A fallback swap replaces the whole Inference object with that entry's,\nfalling through to the provider when the fallback declares none.",
      "originalText": "A fallback swap replaces the whole Inference object with that entry's,\nfalling through to the provider when the fallback declares none.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400049, "version": 1, "versionNonce": 400050, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "s3_foot", "x": 60, "y": 1290, "width": 1500, "height": 38,
      "text": "Setting a typed property writes into the same Options object, so Temperature and Options[\"temperature\"]\nare one entry. Verified against ServiceCollectionExtensions.cs and BaseLlmStep.cs.",
      "originalText": "Setting a typed property writes into the same Options object, so Temperature and Options[\"temperature\"]\nare one entry. Verified against ServiceCollectionExtensions.cs and BaseLlmStep.cs.",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 400051, "version": 1, "versionNonce": 400052, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 }

