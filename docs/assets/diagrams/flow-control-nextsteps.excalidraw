  "elements": [

    { "type": "text", "id": "title", "x": 60, "y": 40, "width": 1400, "height": 38,
      "text": "Flow control: four steps share one mechanism",
      "originalText": "Flow control: four steps share one mechanism",
      "fontSize": 30, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130001, "version": 1, "versionNonce": 130002, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "subtitle", "x": 60, "y": 86, "width": 1700, "height": 20,
      "text": "There is no branching engine. Group, Loop, Switch and Router just put work into result.NextSteps and return. Break and Parallel are the two exceptions, and the missing arrows are the point.",
      "originalText": "There is no branching engine. Group, Loop, Switch and Router just put work into result.NextSteps and return. Break and Parallel are the two exceptions, and the missing arrows are the point.",
      "fontSize": 15, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130003, "version": 1, "versionNonce": 130004, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "hub", "x": 860, "y": 400, "width": 480, "height": 180,
      "strokeColor": "#1e3a5f", "backgroundColor": "#3b82f6", "fillStyle": "solid",
      "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130005, "version": 1, "versionNonce": 130006, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "hub_t", "x": 884, "y": 424, "width": 432, "height": 132,
      "text": "result.NextSteps\n\nthe engine copies the list,\nclears it, and runs it before\nthe next configured step",
      "originalText": "result.NextSteps\n\nthe engine copies the list,\nclears it, and runs it before\nthe next configured step",
      "fontSize": 16, "fontFamily": 3, "textAlign": "center", "verticalAlign": "top",
      "strokeColor": "#ffffff", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130007, "version": 1, "versionNonce": 130008, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "g", "x": 100, "y": 170, "width": 620, "height": 110,
      "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130009, "version": 1, "versionNonce": 130010, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "g_t", "x": 122, "y": 186, "width": 580, "height": 80,
      "text": "GroupStep          pushes its whole Steps list, in order\nNestable, because the push is uniform: a group inside a\ngroup is just another push. The parent flow resumes after\nthe last nested step.",
      "originalText": "GroupStep          pushes its whole Steps list, in order\nNestable, because the push is uniform: a group inside a\ngroup is just another push. The parent flow resumes after\nthe last nested step.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130011, "version": 1, "versionNonce": 130012, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "l", "x": 100, "y": 320, "width": 620, "height": 128,
      "strokeColor": "#6d28d9", "backgroundColor": "#ddd6fe", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130013, "version": 1, "versionNonce": 130014, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "l_t", "x": 122, "y": 336, "width": 580, "height": 98,
      "text": "LoopStep           re-pushes Steps once per iteration\nEach pass adds the path part \"{Name}/Iter_{n}\", so cached\nresults and events stay unique per iteration. MaxRetries is\nforced to 1: the loop is the retry mechanism. On exhaustion\nit emits LoopExhaustedEvent, meaning it never converged.",
      "originalText": "LoopStep           re-pushes Steps once per iteration\nEach pass adds the path part \"{Name}/Iter_{n}\", so cached\nresults and events stay unique per iteration. MaxRetries is\nforced to 1: the loop is the retry mechanism. On exhaustion\nit emits LoopExhaustedEvent, meaning it never converged.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130015, "version": 1, "versionNonce": 130016, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "b", "x": 100, "y": 488, "width": 620, "height": 110,
      "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130017, "version": 1, "versionNonce": 130018, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "b_t", "x": 122, "y": 504, "width": 580, "height": 80,
      "text": "BreakStep          pushes nothing; it unwinds\nReturns a BreakStepResult carrying input.Value. The\nenclosing LoopStep unwraps it into an ordinary result, so a\nbreak can never escape into an outer loop by accident.",
      "originalText": "BreakStep          pushes nothing; it unwinds\nReturns a BreakStepResult carrying input.Value. The\nenclosing LoopStep unwraps it into an ordinary result, so a\nbreak can never escape into an outer loop by accident.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130019, "version": 1, "versionNonce": 130020, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "s", "x": 1480, "y": 250, "width": 620, "height": 110,
      "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130021, "version": 1, "versionNonce": 130022, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "s_t", "x": 1502, "y": 266, "width": 580, "height": 80,
      "text": "SwitchStep         pushes exactly one step\nYour selector returns (IStep target, IStepResult value) and\nthe target is appended to that value's NextSteps. Returning\nnull for either element throws. Emits StepRoutingEvent.",
      "originalText": "SwitchStep         pushes exactly one step\nYour selector returns (IStep target, IStepResult value) and\nthe target is appended to that value's NextSteps. Returning\nnull for either element throws. Emits StepRoutingEvent.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130023, "version": 1, "versionNonce": 130024, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "r", "x": 1480, "y": 400, "width": 620, "height": 110,
      "strokeColor": "#b45309", "backgroundColor": "#fef3c7", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130025, "version": 1, "versionNonce": 130026, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "r_t", "x": 1502, "y": 416, "width": 580, "height": 80,
      "text": "RouterStep         pushes the step a string key maps to\nSame push as SwitchStep, but the key comes from an\nIRouterResult, matched ignoring case. No DefaultRoute and\nno match is an InvalidOperationException.",
      "originalText": "RouterStep         pushes the step a string key maps to\nSame push as SwitchStep, but the key comes from an\nIRouterResult, matched ignoring case. No DefaultRoute and\nno match is an InvalidOperationException.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130027, "version": 1, "versionNonce": 130028, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "p", "x": 1480, "y": 550, "width": 620, "height": 128,
      "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130029, "version": 1, "versionNonce": 130030, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "p_t", "x": 1502, "y": 566, "width": 580, "height": 98,
      "text": "ParallelStep       the exception: pushes nothing\nIt runs its Branches itself with Parallel.ForEachAsync, on\ncloned contexts, and aggregates into a ParallelResult. It is\nthe only one of the six that does not go through NextSteps.\nSee the branch isolation diagram.",
      "originalText": "ParallelStep       the exception: pushes nothing\nIt runs its Branches itself with Parallel.ForEachAsync, on\ncloned contexts, and aggregates into a ParallelResult. It is\nthe only one of the six that does not go through NextSteps.\nSee the branch isolation diagram.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130031, "version": 1, "versionNonce": 130032, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

