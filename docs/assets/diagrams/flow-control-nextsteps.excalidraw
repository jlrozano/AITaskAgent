    { "type": "text", "id": "why", "x": 100, "y": 660, "width": 660, "height": 114,
      "text": "Why this matters\nBecause the push is the only mechanism, the shape of a run\ndoes not have to be known when you write it. An LLM step\nthat decides what happens next uses exactly the same\ndoor as a GroupStep declared up front. That is what makes\nrouting and iterative refinement possible at all.",
      "originalText": "Why this matters\nBecause the push is the only mechanism, the shape of a run\ndoes not have to be known when you write it. An LLM step\nthat decides what happens next uses exactly the same\ndoor as a GroupStep declared up front. That is what makes\nrouting and iterative refinement possible at all.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130041, "version": 1, "versionNonce": 130042, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "rectangle", "id": "cyc", "x": 860, "y": 640, "width": 480, "height": 96,
      "strokeColor": "#dc2626", "backgroundColor": "#fee2e2", "fillStyle": "solid",
      "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130043, "version": 1, "versionNonce": 130044, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "roundness": {"type": 3} },
    { "type": "text", "id": "cyc_t", "x": 882, "y": 658, "width": 436, "height": 60,
      "text": "And why it is dangerous\nA step that pushes itself loops forever.\nNothing in the engine checks for that.",
      "originalText": "And why it is dangerous\nA step that pushes itself loops forever.\nNothing in the engine checks for that.",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#991b1b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 130045, "version": 1, "versionNonce": 130046, "isDeleted": false,
      "groupIds": [], "boundElements": null, "link": null, "locked": false,
      "containerId": null, "lineHeight": 1.25 },

    { "type": "text", "id": "foot", "x": 100, "y": 800, "width": 2000, "height": 19,
      "text": "Verified against GroupStep.cs, LoopStep.cs, BreakStep.cs, SwitchStep.cs, RouterStep.cs, ParallelStep.cs and Pipeline.cs.",
